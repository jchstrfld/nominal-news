.env
*.env
.env.*
!/.env.example
secrets/
*.key
*.pem

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs & caches
*.log
*.cache/
.cache/
pytest_cache/
coverage/
htmlcov/

# Builds
build/
dist/

# Generated outputs
data/
outputs/
*.db
*.sqlite
articles_raw*.json
articles_raw_normalized_*.json
